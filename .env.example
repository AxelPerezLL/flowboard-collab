# ============================================
# DATABASE - MariaDB
# ============================================
DB_ROOT_PASSWORD=root123
DB_NAME=flowboard
DB_USER=flowboard_user
DB_PASSWORD=secure_password

# ============================================
# BACKEND - .NET 8
# ============================================
ASPNETCORE_ENVIRONMENT=Development

# Connection String (usando nombres de servicios Docker)
DB_CONNECTION_STRING=Server=mariadb;Database=flowboard;User=root;Password=root123;Port=3306;SslMode=None

# JWT Authentication
JWT_SECRET_KEY=YourSuperSecretKeyWithAtLeast32Characters123!
JWT_ISSUER=FlowBoardAPI
JWT_AUDIENCE=FlowBoardClient

# SignalR
SIGNALR_HUB_URL=/hub

# ============================================
# FRONTEND - React + Vite
# ============================================
VITE_API_URL=http://localhost:5000/api
VITE_SIGNALR_URL=http://localhost:5000/hub
VITE_APP_NAME=FlowBoard

# ============================================
# MinIO - S3 File Storage
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
STORAGE_CONTAINER_NAME=flowboard-files
STORAGE_CONNECTION_STRING=http://minio:9000

# ============================================
# REDIS - Cache & SignalR Backplane
# ============================================
REDIS_CONNECTION_STRING=redis:6379
REDIS_INSTANCE_NAME=FlowBoard

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=Information
LOG_OUTPUT_TEMPLATE={Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}